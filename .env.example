# Persistent Docker data (outside the source tree)
VIDEOMIND_DATA_ROOT=E:/VideoMindData

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=videomind
MYSQL_ROOT_PASSWORD=root
MYSQL_USERNAME=root
MYSQL_PASSWORD=root

# MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9002
MINIO_ENDPOINT=http://localhost:9000
MINIO_PRESIGN_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=videomind-videos

# RocketMQ
ROCKETMQ_NAME_SERVER=localhost:9876
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_VIP_PORT=10909
PROCESSING_TASK_TOPIC=videomind-processing-task-topic
PROCESSING_TASK_CONSUMER_GROUP=videomind-processing-task-consumer

# ASR/OCR analysis branches (local bounded worker pool)
VIDEO_ANALYSIS_BRANCH_THREADS=2
VIDEO_ANALYSIS_BRANCH_QUEUE_CAPACITY=8

# Redis Stack: locks, rate limiting, upload bitmap only
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_INSIGHT_PORT=8001
REDIS_DATABASE=0

# Cache Redis: hot conversation context only
CACHE_REDIS_HOST=localhost
CACHE_REDIS_PORT=6382
CACHE_REDIS_DATABASE=0
CACHE_REDIS_PASSWORD=
CACHE_REDIS_MAXMEMORY=256mb
CACHE_CONTEXT_TTL_SECONDS=7200

# Elasticsearch hybrid retrieval
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_PORT=9201
ELASTICSEARCH_URL=http://localhost:9201
ELASTICSEARCH_INDEX_ALIAS=videomind-chunks
ELASTICSEARCH_PHYSICAL_INDEX=videomind-chunks-v1
ELASTICSEARCH_DIMENSION=1024
ELASTICSEARCH_NUM_CANDIDATES=200
ELASTICSEARCH_CONNECT_TIMEOUT_MILLIS=2000
# The first index creation can be slow on Docker Desktop bind-mounted storage.
ELASTICSEARCH_READ_TIMEOUT_MILLIS=60000

# Local MinerU pipeline (CPU, concurrency 1)
MINERU_LOCAL_BASE_URL=http://127.0.0.1:8003
MINERU_LOCAL_BACKEND=pipeline
MINERU_LOCAL_CONCURRENCY=1
MINERU_MODEL_SOURCE=modelscope
MINERU_TIMEOUT_SECONDS=300

# Local PaddleOCR (CPU, one worker and one in-flight inference)
LOCAL_OCR_ENDPOINT=http://127.0.0.1:8868/ocr
OCR_DETECTION_MODEL=PP-OCRv5_mobile_det
OCR_RECOGNITION_MODEL=PP-OCRv5_mobile_rec
OCR_MAX_UPLOAD_BYTES=20971520
OCR_SCENE_THRESHOLD=0.30
OCR_MAX_INTERVAL_SECONDS=30
OCR_MAX_FRAMES=300
OCR_TIMEOUT_SECONDS=60

# Local executables. Override only when they are not in PATH.
# FFMPEG_BINARY_PATH=E:/FFmpeg/bin/ffmpeg.exe
# FFPROBE_BINARY_PATH=E:/FFmpeg/bin/ffprobe.exe

# Local auth values. start.ps1 generates persistent development values under
# runtime/local-secrets.env when these placeholders are unchanged.
VIDEOMIND_JWT_SECRET=replace-with-at-least-32-random-characters
VIDEOMIND_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-encryption-key
VIDEOMIND_FRONTEND_URL=http://localhost:5173

# Tencent ASR credentials MUST be rotated after exposure and supplied through
# local process/user environment variables. Never place real values here.
# TENCENT_CLOUD_SECRET_ID=your_rotated_secret_id
# TENCENT_CLOUD_SECRET_KEY=your_rotated_secret_key
ASR_PROVIDER=tencent
TENCENT_ASR_ENDPOINT=https://asr.tencentcloudapi.com
TENCENT_ASR_REGION=ap-shanghai
TENCENT_ASR_ENGINE_MODEL=16k_zh_en_2.0
TENCENT_ASR_POLL_INTERVAL_MILLIS=1000
TENCENT_ASR_TIMEOUT_SECONDS=600
TENCENT_ASR_CHUNK_SECONDS=120
TENCENT_ASR_CHUNK_OVERLAP_MS=1000
TENCENT_ASR_MAX_INLINE_BYTES=5242880
TENCENT_ASR_SUBMISSION_UNKNOWN_TIMEOUT_SECONDS=120
TENCENT_ASR_PROVIDER_TASK_TTL_HOURS=24

# SiliconFlow credential MUST also be a local process/user environment value.
# SILICONFLOW_API_KEY=your_siliconflow_api_key
VIDEOMIND_ASR_MODE=real
VIDEOMIND_SUMMARY_MODE=real
VIDEOMIND_EMBEDDING_MODE=real
VIDEOMIND_RERANK_MODE=real
VIDEOMIND_CHAT_MODE=real
VIDEOMIND_VISION_MODE=real

ASR_API_ENDPOINT=https://api.siliconflow.cn/v1/audio/transcriptions
ASR_MODEL=TeleAI/TeleSpeechASR
ASR_TIMEOUT_SECONDS=300

SUMMARY_API_ENDPOINT=https://api.siliconflow.cn/v1/chat/completions
SUMMARY_MODEL=deepseek-ai/DeepSeek-V4-Flash
SUMMARY_PROMPT_VERSION=summary-v6-layered-fusion
SUMMARY_TIMEOUT_SECONDS=120

EMBEDDING_API_ENDPOINT=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=120

RERANK_API_ENDPOINT=https://api.siliconflow.cn/v1/rerank
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TIMEOUT_SECONDS=120

CHAT_API_ENDPOINT=https://api.siliconflow.cn/v1/chat/completions
CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
CHAT_TIMEOUT_SECONDS=120

# DashScope Qwen-VL credential must be supplied through a local process/user environment.
# DASHSCOPE_API_KEY=your_dashscope_api_key
VISION_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3-vl-plus
VISION_TIMEOUT_SECONDS=90
VISION_CONCURRENCY=3
VISION_MAX_ATTEMPTS=2

# Knowledge chunking
KNOWLEDGE_EMBEDDING_DIM=1024
KNOWLEDGE_CHUNK_SIZE=600
KNOWLEDGE_CHUNK_OVERLAP=80
# Deep Planner/Critic structured-decision timeout; invalid/timeout decisions fall back to bounded rules.
AGENT_DECISION_TIMEOUT_MILLIS=10000
