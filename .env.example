# Docker persistent data directory (outside the source workspace)
VIDEOMIND_DATA_ROOT=E:/VideoMindData
REDIS_PORT=6380
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=videomind
MYSQL_USERNAME=root
MYSQL_PASSWORD=root

# Optional when ffprobe is installed outside PATH. If unavailable, VideoMind
# falls back to the duration metadata emitted by the configured ffmpeg binary.
# FFPROBE_BINARY_PATH=ffprobe

# Database DDL is managed exclusively by Flyway migrations in
# backend/videomind-server/src/main/resources/db/migration.

# Configure this as a Windows user environment variable, not in Git:
# SILICONFLOW_API_KEY=your_api_key
# ASR_MODEL=TeleAI/TeleSpeechASR
# SUMMARY_MODEL=deepseek-ai/DeepSeek-V4-Flash
# CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Agent Platform. Stage 2 enables only advanced-mode transcript ingest.
VIDEOMIND_AGENT_ENABLED=false
VIDEOMIND_AGENT_INGEST_ENABLED=false
VIDEOMIND_AGENT_CHAT_ENABLED=false
VIDEOMIND_AGENT_WEB_SEARCH_ENABLED=false
VIDEOMIND_AGENT_ADVANCED_REPORT_ENABLED=false
VIDEOMIND_AGENT_PRESENTATION_ENABLED=false
AGENT_PLATFORM_BASE_URL=http://localhost:8090
AGENT_PLATFORM_TENANT_ID=videomind
# Legacy compatibility only; OAuth is used for formal VideoMind-to-MindAgent authentication.
# AGENT_PLATFORM_API_KEY=your_agent_api_key
# AGENT_PLATFORM_SIGNING_SECRET=your_signing_secret
VIDEOMIND_JWT_SECRET=replace-with-at-least-32-random-characters
VIDEOMIND_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-encryption-key
VIDEOMIND_FRONTEND_URL=http://localhost:5173
AGENT_PLATFORM_OAUTH_CLIENT_ID=videomind
AGENT_PLATFORM_OAUTH_CLIENT_SECRET=replace-with-mindagent-client-secret
AGENT_PLATFORM_OAUTH_REDIRECT_URI=http://localhost:8080/api/integrations/mindagent/callback
AGENT_PLATFORM_FRONTEND_URL=http://localhost:5174
AGENT_PLATFORM_WEBHOOK_SECRET=replace-with-mindagent-webhook-secret
MINIO_PRESIGN_ENDPOINT=http://host.docker.internal:9000
AGENT_PRESIGNED_URL_EXPIRY_SECONDS=900
AGENT_TASK_POLL_INTERVAL_SECONDS=5
